{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Observability": {
    "ConsoleEnabled": true,
    "File": {
      "Enabled": true,
      "Path": "logs/roadmate-.log",
      "RetainedFiles": 14
    },
    "Elasticsearch": {
      "Enabled": false,
      "Uri": "http://localhost:9200",
      "IndexFormat": "roadmate-logs-{0:yyyy.MM.dd}",
      "Username": "",
      "BufferPath": "logs/es-buffer"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=postgres;Port=5432;Database=roadmate;Username=roadmate;Password=roadmate"
  },
  "Database": {
    "EnsureCreated": false
  },
  "Auth": {
    "UseDevAuth": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Firebase": {
    "ProjectId": "se405-roadmate",
    "CredentialPath": ""
  },
  "Storage": {
    "Bucket": "se405-roadmate.firebasestorage.app",
    "UploadUrlMinutes": 15,
    "DownloadUrlMinutes": 60,
    "MaxImageBytes": 5242880,
    "MaxVideoBytes": 26214400,
    "VerifyOnCreate": true,
    "EnforceSizeLimit": true
  },
  "Alert": {
    "RepeatMinutes": 2,
    "SlowRepeatMinutes": 10,
    "MaxRepeats": 30,
    "WorkerPollSeconds": 15
  },
  "Safety": {
    "LostSignalMinutes": 10,
    "LateReturnGraceMinutes": 60,
    "LateReturnOwnerResponseMinutes": 15,
    "MonitorIntervalSeconds": 30
  },
  "Tracking": {
    "BaseUrl": "https://roadmate.app/track",
    "AckUrl": "",
    "ExpireAfterFinishMinutes": 120
  },
  "Goong": {
    "ApiKey": "",
    "BaseUrl": "https://rsapi.goong.io"
  },
  "Sms": {
    "Provider": "log",
    "StripDiacritics": true,
    "ESms": {
      "ApiKey": "",
      "SecretKey": "",
      "SmsType": "8",
      "Brandname": "",
      "Endpoint": "https://rest.esms.vn/MainService.svc/json/SendMultipleMessage_V4_post_json/",
      "Sandbox": false,
      "TimeoutSeconds": 15
    }
  },
  "Debug": {
    "EnableSimulator": false,
    "AllowedPhones": []
  }
}